{
  "name": "zenx-multilogin",
  "productName": "Zenx MultiLogin",
  "version": "1.0.0",
  "description": "Gerenciador local de perfis de navegador Chromium isolados.",
  "author": "Zenx",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/services.test.ts tests/filters.test.ts",
    "icons": "node scripts/generate-icons.mjs",
    "chromium": "node scripts/prepare-chromium.mjs",
    "db:generate": "drizzle-kit generate",
    "dist": "npm run icons && npm run chromium && npm run build && electron-builder --win --x64",
    "verify:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-install.ps1"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "playwright-core": "^1.65.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
